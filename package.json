{
  "name": "scdt-savings-rw",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "sync-client": "node scripts/sync-client-assets.js",
    "start": "npm run sync-client && expo start",
    "android": "npm run sync-client && expo start --android",
    "ios": "npm run sync-client && expo start --ios",
    "eas-build-pre-install": "node scripts/sync-client-assets.js",
    "build:android": "npm run sync-client && eas build --platform android",
    "build:ios": "npm run sync-client && eas build --platform ios",
    "lint": "expo lint",
    "build:web": "npm run sync-client && npx expo export --platform web",
    "deploy": "npm run build:web && npx wrangler deploy",
    "send-pending-emails": "node scripts/send-pending-emails.js"
  },
