rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function membershipDocId(groupId, userId) {
      return groupId + '_' + userId;
    }

    function ownMembershipRef(groupId) {
      return /databases/$(database)/documents/groupMemberships/$(membershipDocId(groupId, uid()));
    }

    function isOwnMembershipId(id) {
      return isAuth() && id.matches('.*_' + uid());
    }

    function isMember(groupId) {
      return isAuth() && exists(ownMembershipRef(groupId));
    }

    function membershipData(groupId) {
      return get(ownMembershipRef(groupId)).data;
    }

    function memberRole(groupId) {
      return isMember(groupId) ? membershipData(groupId).role : null;
    }

    function memberStatus(groupId) {
      return isMember(groupId) ? membershipData(groupId).status : null;
    }

    function isActiveMember(groupId) {
      return isMember(groupId) && memberStatus(groupId) == 'active';
    }

    function isAdmin(groupId) {
      return isActiveMember(groupId) && memberRole(groupId) == 'admin';
    }

    function isAdminOrAccountant(groupId) {
      return isActiveMember(groupId)
        && memberRole(groupId) in ['admin', 'accountant'];
    }

    function canManageLoans(groupId) {
      return isActiveMember(groupId)
        && memberRole(groupId) in ['admin', 'accountant', 'loan_officer', 'committee'];
    }

    function isAudit(groupId) {
      return isActiveMember(groupId) && memberRole(groupId) == 'audit';
    }

    function memberDocRef(groupId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(membershipData(groupId).memberId);
    }

    function hasMemberDoc(groupId) {
      return exists(ownMembershipRef(groupId))
        && ('memberId' in membershipData(groupId))
        && exists(memberDocRef(groupId));
    }

    function memberPermissions(groupId) {
      return hasMemberDoc(groupId) && ('permissions' in get(memberDocRef(groupId)).data)
        ? get(memberDocRef(groupId)).data.permissions
        : {};
    }

    function hasPermission(groupId, key) {
      return isAdmin(groupId)
        || (isActiveMember(groupId) && (key in memberPermissions(groupId)) && memberPermissions(groupId)[key] == true);
    }

    function canAddContribution(groupId) {
      return isAdminOrAccountant(groupId) || hasPermission(groupId, 'addContribution');
    }

    function canAddLoan(groupId) {
      return canManageLoans(groupId) || hasPermission(groupId, 'addLoan');
    }

    function canAddInvestment(groupId) {
      return isAdminOrAccountant(groupId) || hasPermission(groupId, 'addInvestment');
    }

    function canApproveContributions(groupId) {
      return isAdminOrAccountant(groupId)
        || (isActiveMember(groupId) && memberRole(groupId) == 'loan_officer')
        || hasPermission(groupId, 'approveContributions');
    }

    function canApproveLoans(groupId) {
      return canManageLoans(groupId) || hasPermission(groupId, 'approveLoans');
    }

    function canManageMeetings(groupId) {
      return (isActiveMember(groupId) && memberRole(groupId) in ['admin', 'accountant', 'loan_officer', 'committee'])
        || hasPermission(groupId, 'manageMeetings') || hasPermission(groupId, 'updateMeetings');
    }

    function canDeleteRecords(groupId) {
      return isAdmin(groupId) || hasPermission(groupId, 'deleteRecords');
    }

    function emailsMatch(stored) {
      return authEmail() != null
        && stored is string
        && stored.lower() == authEmail().lower();
    }

    function memberUserIdUnset() {
      return !('userId' in resource.data)
        || resource.data.userId == null
        || resource.data.userId == '';
    }

    match /groups/{groupId} {
      // Known group IDs can be fetched during bootstrap. Collection-wide
      // listing is not allowed — memberships are resolved by deterministic IDs.
      allow get: if isAuth();
      allow list: if false;

      allow create: if isAuth()
        && request.resource.data.createdBy == uid();

      allow update: if isAdminOrAccountant(groupId)
        || hasPermission(groupId, 'manageSettings')
        || (isAuth()
            && resource.data.createdBy == uid()
            && !exists(ownMembershipRef(groupId)));

      allow delete: if isAdmin(groupId);

      match /members/{memberId} {
        allow read: if isMember(groupId)
          || (isAuth() && memberId == uid())
          || (isAuth() && resource.data.userId == uid())
          || (isAuth() && emailsMatch(resource.data.email) && memberUserIdUnset());

        allow create: if isAuth() && (
          isAdminOrAccountant(groupId)
          || request.resource.data.userId == uid()
          || request.resource.data.id == '_init'
          || request.resource.data.system == true
        );

        allow update: if isAdminOrAccountant(groupId)
          || hasPermission(groupId, 'editMembers')
          || (isAuth()
              && resource.data.userId == uid()
              && !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny(['role', 'status', 'userId', 'groupId', 'permissions']))
          || (isAuth()
              && emailsMatch(resource.data.email)
              && memberUserIdUnset()
              && request.resource.data.userId == uid()
              && !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny(['role', 'status', 'groupId', 'permissions']));

        allow delete: if isAdmin(groupId) || hasPermission(groupId, 'editMembers');
      }

      match /contributionGoalPeriods/{id} {
        allow read: if isMember(groupId);
        // getCurrentGoalPeriod() runs a getDocs(query(where('periodStart',
        // '==', ...), where('periodEnd', '==', ...))). A query operation
        // needs a `list` rule; `allow read` alone is a shortcut for
        // `get + list`, but only holds when the condition is
        // resource.data-free. Adding an explicit list rule with just
        // isMember gives Firestore something it CAN prove for a
        // whole-collection query.
        allow list: if isMember(groupId);

        allow create: if isActiveMember(groupId);

        allow update: if isAdminOrAccountant(groupId)
          || hasPermission(groupId, 'manageSettings')
          || (isActiveMember(groupId)
              && request.resource.data.targetAmount == resource.data.targetAmount
              && request.resource.data.periodStart == resource.data.periodStart
              && request.resource.data.periodEnd == resource.data.periodEnd
              && request.resource.data.minimumContribution == resource.data.minimumContribution);

        allow delete: if isAdmin(groupId);
      }

      match /contributions/{id} {
        allow read: if isAdminOrAccountant(groupId)
          || (isActiveMember(groupId) && memberRole(groupId) in ['loan_officer', 'committee'])
          || (isActiveMember(groupId) && resource.data.memberId == membershipData(groupId).memberId);
        // Explicit list — the read rule above references resource.data,
        // so Firestore can't prove it for an unfiltered whole-collection
        // list query. subscribeContributions runs exactly that for
        // members and staff.
        allow list: if isAdminOrAccountant(groupId)
          || (isActiveMember(groupId) && memberRole(groupId) in ['loan_officer', 'committee'])
          || isActiveMember(groupId);
        allow create: if isAuth() && (
          canAddContribution(groupId)
          || (isActiveMember(groupId) && request.resource.data.memberId == membershipData(groupId).memberId)
          || request.resource.data.id == '_init'
          || request.resource.data.system == true
        );
        allow update: if canApproveContributions(groupId);
        allow delete: if canDeleteRecords(groupId);
      }

      match /loans/{id} {
        allow read: if isAdminOrAccountant(groupId)
          || (isActiveMember(groupId) && memberRole(groupId) in ['loan_officer', 'committee'])
          || (isActiveMember(groupId) && resource.data.memberId == membershipData(groupId).memberId);
        // THE FIX: without this list rule, subscribeLoans's
        // query(loansCol(gId), orderBy('createdAt', 'desc')) is denied
        // for members — the read rule's condition references
        // resource.data.memberId, which Firestore cannot evaluate for
        // a whole-collection list. Admins were unaffected because
        // isAdminOrAccountant(groupId) is provable for the whole query.
        allow list: if isAdminOrAccountant(groupId)
          || (isActiveMember(groupId) && memberRole(groupId) in ['loan_officer', 'committee'])
          || isActiveMember(groupId);
        allow create: if isAuth() && (
          canAddLoan(groupId)
          || (isActiveMember(groupId) && request.resource.data.memberId == membershipData(groupId).memberId)
          || request.resource.data.id == '_init'
          || request.resource.data.system == true
        );
        allow update: if canApproveLoans(groupId);
        allow delete: if canDeleteRecords(groupId);
      }

      match /walletTransactions/{id} {
        allow read: if isAdminOrAccountant(groupId);
        allow create: if isAuth() && (
          isAdminOrAccountant(groupId)
          || request.resource.data.id == '_init'
          || request.resource.data.system == true
        );
        allow update: if isAdminOrAccountant(groupId);
        allow delete: if isAdminOrAccountant(groupId);
      }

      match /expenses/{id} {
        allow read: if isAdminOrAccountant(groupId);
        allow create: if isAuth() && (
          isAdminOrAccountant(groupId)
          || request.resource.data.id == '_init'
          || request.resource.data.system == true
        );
        allow update: if isAdminOrAccountant(groupId);
        allow delete: if canDeleteRecords(groupId);
      }

      match /meetings/{id} {
        allow read: if isMember(groupId);
        allow create: if isAuth() && (
          canManageMeetings(groupId)
          || request.resource.data.id == '_init'
          || request.resource.data.system == true
        );
        allow update: if canManageMeetings(groupId);
        allow delete: if canDeleteRecords(groupId);
      }

      match /investments/{id} {
        allow read: if isAdminOrAccountant(groupId)
          || (isActiveMember(groupId) && memberRole(groupId) == 'committee');
        // Pre-emptive list rule — same latent issue as loans. A member's
        // investments subscription (see useFirebaseSync.ts) will fail
        // with permission-denied if the client-side viewAllInvestments
        // flag ever flips for a plain member without this clause.
        allow list: if isAdminOrAccountant(groupId)
          || (isActiveMember(groupId) && memberRole(groupId) == 'committee')
          || isActiveMember(groupId);
        allow create: if isAuth() && (
          canAddInvestment(groupId)
          || request.resource.data.id == '_init'
          || request.resource.data.system == true
        );
        allow update: if isAdminOrAccountant(groupId)
          || (isActiveMember(groupId) && memberRole(groupId) == 'committee')
          || hasPermission(groupId, 'approveInvestments');
        allow delete: if canDeleteRecords(groupId);
      }

      match /auditLogs/{id} {
        allow read: if isAdminOrAccountant(groupId) || isAudit(groupId);
        allow create: if isAuth() && request.resource.data.userId == uid();
        allow update: if false;
        allow delete: if false;
      }

      match /deletions/{id} {
        allow read: if isAdminOrAccountant(groupId);
        allow create: if isAdminOrAccountant(groupId);
        allow update: if false;
        allow delete: if isAdmin(groupId);
      }
    }

    match /groupMemberships/{id} {
      allow get: if isAuth() && (
        isOwnMembershipId(id)
        || (resource.data.userId == uid())
        || isAdmin(resource.data.groupId)
      );

      allow list: if isAuth() && resource.data.userId == uid();

      allow create: if isAuth() && (
        request.resource.data.userId == uid()
        || isAdmin(request.resource.data.groupId)
      );

      allow update: if isAuth() && (
        isAdmin(resource.data.groupId)
        || (resource.data.userId == uid()
            && !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['role', 'groupId', 'userId', 'memberId']))
      );

      allow delete: if isAuth() && (
        resource.data.userId == uid()
        || isAdmin(resource.data.groupId)
      );
    }

    match /pendingMemberLinks/{emailKey} {
      allow get: if isAuth()
        && authEmail() != null
        && emailKey == authEmail().lower();

      allow list: if false;

      allow create: if isAuth()
        && isAdmin(request.resource.data.groupId)
        && request.resource.data.email is string
        && emailKey == request.resource.data.email.lower();

      allow update, delete: if isAuth() && (
        isAdmin(resource.data.groupId)
        || (authEmail() != null && emailKey == authEmail().lower())
      );
    }

    match /users/{userId}/notifications/{id} {
      allow read:   if isAuth() && uid() == userId;
      allow create: if isAuth();
      allow update: if isAuth() && uid() == userId;
      allow delete: if isAuth() && uid() == userId;
    }

    match /pendingEmails/{id} {
      allow read:   if false;
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }

    match /pendingTokenRequests/{id} {
      allow read:   if isAuth() && isAdmin(resource.data.groupId);
      allow create: if true;
      allow update: if isAuth() && isAdmin(resource.data.groupId);
      allow delete: if isAuth() && isAdmin(resource.data.groupId);
    }
  }
}