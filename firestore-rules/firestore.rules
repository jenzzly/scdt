rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────
    // AUTH
    // ─────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ─────────────────────────────
    // MEMBERSHIP HELPERS
    // ─────────────────────────────
    function membershipDocId(groupId) {
      return groupId + "_" + uid();
    }

    function membershipRef(groupId) {
      return /databases/$(database)/documents/groupMemberships/$(membershipDocId(groupId));
    }

    function isMember(groupId) {
      return isAuth() && exists(membershipRef(groupId));
    }

    function membershipData(groupId) {
      return get(membershipRef(groupId)).data;
    }

    function memberRole(groupId) {
      return isMember(groupId) ? membershipData(groupId).role : null;
    }

    function memberStatus(groupId) {
      return isMember(groupId) ? membershipData(groupId).status : null;
    }

    function isActiveMember(groupId) {
      return isMember(groupId) && memberStatus(groupId) == "active";
    }

    function isAdmin(groupId) {
      return isActiveMember(groupId) && memberRole(groupId) == "admin";
    }

    function isAdminOrAccountant(groupId) {
      return isActiveMember(groupId)
        && memberRole(groupId) in ["admin", "accountant"];
    }

    function canManageLoans(groupId) {
      return isActiveMember(groupId)
        && memberRole(groupId) in ["admin", "accountant", "loan_officer"];
    }

    function memberDocRef(groupId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(membershipData(groupId).memberId);
    }

    function hasMemberDoc(groupId) {
      return exists(membershipRef(groupId))
        && ('memberId' in membershipData(groupId))
        && exists(memberDocRef(groupId));
    }

    function memberPermissions(groupId) {
      return hasMemberDoc(groupId) && ('permissions' in get(memberDocRef(groupId)).data)
        ? get(memberDocRef(groupId)).data.permissions
        : {};
    }

    function hasPermission(groupId, key) {
      return isAdmin(groupId)
        || (isActiveMember(groupId) && (key in memberPermissions(groupId)) && memberPermissions(groupId)[key] == true);
    }

    function canAddContribution(groupId) {
      return isAdminOrAccountant(groupId) || hasPermission(groupId, 'addContribution');
    }

    function canAddLoan(groupId) {
      return canManageLoans(groupId) || hasPermission(groupId, 'addLoan');
    }

    function canAddInvestment(groupId) {
      return isAdminOrAccountant(groupId) || hasPermission(groupId, 'addInvestment');
    }

    function canApproveContributions(groupId) {
      return isAdminOrAccountant(groupId) || hasPermission(groupId, 'approveContributions');
    }

    function canApproveLoans(groupId) {
      return canManageLoans(groupId) || hasPermission(groupId, 'approveLoans');
    }

    function canManageMeetings(groupId) {
      return isAdminOrAccountant(groupId) || hasPermission(groupId, 'manageMeetings') || hasPermission(groupId, 'updateMeetings');
    }

    function canDeleteRecords(groupId) {
      return isAdmin(groupId) || hasPermission(groupId, 'deleteRecords');
    }

    // ─────────────────────────────
    // GROUPS
    // ─────────────────────────────
    match /groups/{groupId} {

      // Any authenticated user can read (needed during initGroupData checks)
      allow read: if isAuth();

      // Any authenticated user can create a group
      allow create: if isAuth();

      // Admins/accountants update normally.
      // Also allow update during initial setup when membership doesn't exist yet
      // (the founder is setting up the group before their membership doc is created).
      allow update: if isAdminOrAccountant(groupId)
        || hasPermission(groupId, 'manageSettings')
        || (isAuth() && !exists(membershipRef(groupId)));

      allow delete: if isAdmin(groupId);

      // ───────── MEMBERS ─────────
      match /members/{memberId} {

        allow read: if isMember(groupId);

        // (a) Admin/accountant adding someone
        // (b) User self-registering (their own userId on the doc)
        // (c) _init placeholder for collection bootstrapping
        // (d) system=true docs written by initGroupData
        allow create: if isAuth() && (
          isAdminOrAccountant(groupId)
          || request.resource.data.userId == uid()
          || request.resource.data.id == "_init"
          || request.resource.data.system == true
        );

        allow update: if isAdminOrAccountant(groupId)
          || hasPermission(groupId, 'editMembers')
          || (isAuth()
              && resource.data.userId == uid()
              && !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny(["role", "status", "userId", "groupId", "permissions"]));

        allow delete: if isAdmin(groupId) || hasPermission(groupId, 'editMembers');
      }

      // ───────── CONTRIBUTIONS ─────────
      match /contributions/{id} {
        allow read: if isMember(groupId);

        allow create: if isAuth() && (
          canAddContribution(groupId)
          || request.resource.data.id == "_init"
          || request.resource.data.system == true
        );

        allow update: if canApproveContributions(groupId);
        allow delete: if canDeleteRecords(groupId);
      }

      // ───────── LOANS ─────────
      match /loans/{id} {
        allow read: if isMember(groupId);

        allow create: if isAuth() && (
          canAddLoan(groupId)
          || request.resource.data.id == "_init"
          || request.resource.data.system == true
        );

        allow update: if canApproveLoans(groupId);
        allow delete: if canDeleteRecords(groupId);
      }

      // ───────── WALLET TRANSACTIONS ─────────
      match /walletTransactions/{id} {
        allow read: if isMember(groupId);

        allow create: if isAuth() && (
          canAddContribution(groupId)
          || isAdminOrAccountant(groupId)
          || request.resource.data.id == "_init"
          || request.resource.data.system == true
        );

        // Only admins or users with deleteRecords can update/soft-delete
        allow update: if canDeleteRecords(groupId);
        allow delete: if canDeleteRecords(groupId);
      }

      // ───────── EXPENSES ─────────
      match /expenses/{id} {
        allow read: if isMember(groupId);

        allow create: if isAuth() && (
          isAdminOrAccountant(groupId)
          || request.resource.data.id == "_init"
          || request.resource.data.system == true
        );

        allow update: if isAdminOrAccountant(groupId);
        allow delete: if canDeleteRecords(groupId);
      }

      // ───────── MEETINGS ─────────
      match /meetings/{id} {
        allow read: if isMember(groupId);

        allow create: if isAuth() && (
          canManageMeetings(groupId)
          || request.resource.data.id == "_init"
          || request.resource.data.system == true
        );

        allow update: if canManageMeetings(groupId);
        allow delete: if canDeleteRecords(groupId);
      }

      // ───────── INVESTMENTS ─────────
      match /investments/{id} {
        allow read: if isMember(groupId);

        allow create: if isAuth() && (
          canAddInvestment(groupId)
          || request.resource.data.id == "_init"
          || request.resource.data.system == true
        );

        allow update: if isAdminOrAccountant(groupId) || hasPermission(groupId, 'approveInvestments');
        allow delete: if canDeleteRecords(groupId);
      }

      // ───────── AUDIT LOGS ─────────
      match /auditLogs/{id} {
        allow read: if isAdminOrAccountant(groupId);

        // Any authenticated user can write their own audit entries.
        // We don't require isMember() here because during initGroupData
        // the founder writes an audit log before membership propagates.
        allow create: if isAuth()
          && request.resource.data.userId == uid();

        allow update: if false;
        allow delete: if false;
      }

      // ───────── DELETIONS ─────────
      match /deletions/{id} {
        allow read: if isMember(groupId);
        allow create: if isAdminOrAccountant(groupId);
        allow update: if false;
        allow delete: if isAdmin(groupId);
      }
    }

    // ─────────────────────────────
    // GROUP MEMBERSHIPS
    // ─────────────────────────────
    match /groupMemberships/{id} {

      // Read own docs only
      allow read: if isAuth() && resource.data.userId == uid();

      // Create:
      // (a) self-registration: the doc belongs to the requesting user
      // (b) admin adding a member for another user
      allow create: if isAuth() && (
        request.resource.data.userId == uid()
        || isAdmin(request.resource.data.groupId)
      );

      // Update:
      // (a) owner can update their own membership (e.g. leaving)
      // (b) group admin can update any membership (role/status changes)
      allow update: if isAuth() && (
        resource.data.userId == uid()
        || isAdmin(resource.data.groupId)
      );

      // Only the owner can delete their membership
      allow delete: if isAuth() && resource.data.userId == uid();
    }

    // ─────────────────────────────
    // NOTIFICATIONS
    // ─────────────────────────────
    match /users/{userId}/notifications/{id} {
      allow read:   if isAuth() && uid() == userId;
      allow create: if isAuth();
      allow update: if isAuth() && uid() == userId;
      allow delete: if isAuth() && uid() == userId;
    }
  }
}
