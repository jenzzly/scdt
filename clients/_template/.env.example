# Copy this file to clients/<your-client-id>/.env and fill in the values
# from Firebase Console → Project Settings → Your Apps → Web App config
# for THAT CLIENT'S OWN Firebase project (each client gets a dedicated
# Firebase project — never reuse another client's project here).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
